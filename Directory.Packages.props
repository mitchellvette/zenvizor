<Project>

  <ItemGroup Label="IPC">
    <PackageVersion Include="StreamJsonRpc" Version="2.21.10" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.11.79" />
  </ItemGroup>

  <ItemGroup Label="IPC transitive vulnerability pins">
    <!-- CORRECTION (not suppression) for GHSA-hv8m-jj95-wg3x: MessagePack
         2.5.187 has a CVSS 8.2 high-severity LZ4 decompression OOB read
         vulnerability. StreamJsonRpc 2.21.10's .nuspec declares
         "MessagePack >= 2.5.187" unconditionally for its optional
         MessagePack formatter path; we don't construct that formatter
         (our wire is HeaderDelimitedMessageHandler JSON via
         ZenVizorRpcHost.Host / ZenVizorRpcClient.Attach) and don't import
         a single MessagePack API anywhere in the codebase, so the
         vulnerable code path (Lz4Block / Lz4BlockArray decompression) is
         unreachable today — but the package version in the graph still
         carries the patch obligation.

         Pin to MessagePack 2.5.301 (the patched 2.x release per the
         advisory) via Central Package Management + transitive pinning
         (CentralPackageTransitivePinningEnabled in Directory.Build.props).
         Stays on the same minor as StreamJsonRpc's floor — ABI-compatible
         with the assembly StreamJsonRpc loads at runtime. v3.x is not used
         because it crosses a major boundary and the LZ4 codec moved to a
         separate package; staying on 2.5.x is the conservative diff.

         MessagePack.Annotations is pinned in lockstep — same release train,
         compile-time-only attribute carriers, but kept aligned so a future
         analyzer query against the assets graph reports a single coherent
         MessagePack version. -->
    <PackageVersion Include="MessagePack" Version="2.5.301" />
    <PackageVersion Include="MessagePack.Annotations" Version="2.5.301" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Capture / Attribution (Win32)">
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>

  <ItemGroup Label="Hosting / Logging">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.0" />
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="WPF-UI" Version="4.0.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup Label="CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup Label="Installer (WiX)">
    <!-- WiX 6.0.1 is the last MIT-licensed release. v7+ requires the OSMF
         EULA; do not upgrade past 6.x without revisiting the licensing
         posture of the project. The WiX SDK itself is pinned via the
         <Project Sdk="WixToolset.Sdk/6.0.1"> reference in
         installer/ZenVizor.wixproj. -->
    <PackageVersion Include="WixToolset.Util.wixext" Version="6.0.1" />
  </ItemGroup>

</Project>
