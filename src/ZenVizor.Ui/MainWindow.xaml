<ui:FluentWindow x:Class="ZenVizor.Ui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 mc:Ignorable="d"
                 Title="ZenVizor"
                 Height="720" Width="1200"
                 MinHeight="720" MinWidth="1000"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 Icon="pack://application:,,,/Assets/favicon.ico"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 TextOptions.TextHintingMode="Fixed">
    <!-- Rendering-discipline declarations on the FluentWindow root.
         All four are inheritable: in a fresh tree they propagate to every
         descendant. In practice Wpf.Ui's NavigationView content host
         interposes a ContentPresenter chain that breaks WPF property
         inheritance on Frame-hosted pages — so UseLayoutRounding is ALSO
         set on every Page root in Views/ and every UserControl root in
         Views/Controls/. Belt-and-suspenders, but verified necessary by
         the Dashboard KPI cards (cards 2/3/4 blurry until the row Grid
         got its own UseLayoutRounding=True).

         WHY each property:

         UseLayoutRounding=True — snaps layout coords (Margin, RenderSize,
         Grid * column boundaries, etc.) to whole pixels. Without it, a
         Border at a fractional X origin combined with shadow.card's
         DropShadowEffect causes the Effect's bitmap rasterization pass to
         render text at a sub-pixel offset and blur the composite. The
         TextOptions below DO snap glyphs in the text layer but cannot
         touch the Effect-compositor pass; layout rounding is orthogonal.

         TextFormattingMode=Display — WPF defaults to Ideal (sub-pixel
         glyph positions tuned for clean text scaling), which renders
         blurry at the small font sizes this design system relies on
         (font.size.caption=12, font.size.body=14 — eyebrows, KPI line
         descriptions, app/path rows). Display snaps glyphs to whole
         pixels; canonical fix for small-text blur in WPF Fluent apps.

         TextRenderingMode=ClearType + TextHintingMode=Fixed — prevent
         WPF's Auto modes from silently degrading to Grayscale / Animated
         rendering inside ancestors that have Opacity<1, DropShadowEffect,
         or RenderTransform — all of which this app uses pervasively
         (dim-on-disconnect Opacity=0.6 across every page, shadow.card on
         every metal-recipe card, the badge-pulse ScaleTransform).

         Note: LiveCharts2 chart axis labels render via SkiaSharp, NOT
         WPF, so they do NOT inherit any of these settings. If chart-
         label crispness is a problem, fix lives in ChartTheming.cs /
         SKPaint tuning, not here. Same caveat for any HWND-owning popup
         (WPF Tooltip, ContextMenu, ComboBox dropdown): they don't
         inherit from MainWindow either; if their text is visibly blurry,
         per-style setters are the route. -->


    <!-- Outer Grid carries the brand tint via surface.background (50% alpha
         brand cool / dark slate). Every chrome layer above (TitleBar,
         NavigationView pane + content, bottom-bar) is transparent so they
         all sit on top of THIS tint — uniform brand-cool reading across
         page area AND chrome, no seam between Grid.Column 0 and 1 of
         NavigationView. Mica still shows through the 50% alpha.
         ApplicationBackgroundBrush stays Transparent (App.xaml.cs override)
         so Pages don't double-paint the tint on top of the Grid. -->
    <Grid Background="{DynamicResource surface.background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     ShowMaximize="True"
                     CloseClicked="OnTitleBarCloseClicked">
            <!-- Brand lockup in TitleBar.Header: [logomark] [wordmark]
                 composed as a horizontal StackPanel. Header (NOT Title) is
                 the rich-content slot — Title is string-only despite its
                 `object` C# type because the template binds it as
                 TextBlock.Text. StackPanel.Margin sets left chrome padding;
                 the inner Viewbox.Margin sets the gap between logomark
                 and wordmark.

                 Logomark — Image rendered from Assets/favicon.ico via pack
                 URI. WPF's IconBitmapDecoder picks the closest matching
                 frame from the multi-res .ico for display at 20×20; if it
                 looks soft, embed a 16/20px variant in the .ico (or ship a
                 dedicated SVG/PNG mark for chrome use). The .ico is also
                 referenced by <ApplicationIcon> in the csproj (for the
                 .exe-shell icon Windows uses in Explorer/alt-tab) and by
                 the TaskbarIcon below.

                 Wordmark — reconstructs the Illustrator source
                 (Assets/zv_wordmark_v1.svg) inline using the embedded Nuqun
                 font and the SVG's exact per-letter positioning. The SVG
                 fixed Nuqun's default letter-spacing issues via manual
                 kerning; preserving those positions is the whole point of
                 replicating it in XAML rather than using a plain TextBlock.
                 Foreground binds to text.primary so the wordmark
                 theme-swaps with the chrome. Viewbox handles scaling —
                 Height controls render size; aspect ratio (~3:1) is
                 preserved from the SVG viewBox (353.84 × 116.89).

                 Window.Title="ZenVizor" on FluentWindow above still serves
                 alt-tab / accessibility. -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/favicon.ico"
                           Width="16" Height="16"
                           VerticalAlignment="Center"
                           Margin="0,-8,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Viewbox Stretch="Uniform" Height="20" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Canvas Width="353.84" Height="116.89" Background="Transparent">
                        <TextBlock Canvas.Left="0" Canvas.Top="0"
                                   FontFamily="{StaticResource font.brand}"
                                   FontSize="102.21"
                                   Foreground="{DynamicResource text.primary}"
                                   Text="ze" />
                        <TextBlock Canvas.Left="97.1" Canvas.Top="0"
                                   FontFamily="{StaticResource font.brand}"
                                   FontSize="102.21"
                                   Foreground="{DynamicResource text.primary}"
                                   Text="n" />
                        <TextBlock Canvas.Left="137.16" Canvas.Top="-21"
                                   FontFamily="{StaticResource font.brand}"
                                   FontSize="130"
                                   Foreground="{DynamicResource text.primary}"
                                   Text="v" />
                        <TextBlock Canvas.Left="197.87" Canvas.Top="0"
                                   FontFamily="{StaticResource font.brand}"
                                   FontSize="102.21"
                                   Foreground="{DynamicResource text.primary}"
                                   Text="i"
                                   RenderTransformOrigin="0,1">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleY="0.82" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Canvas.Left="208.19" Canvas.Top="0"
                                   FontFamily="{StaticResource font.brand}"
                                   FontSize="102.21"
                                   Foreground="{DynamicResource text.primary}"
                                   Text="zor" />
                    </Canvas>
                    </Viewbox>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="220">
            <!-- Brand violet on the selected item's icon. WPF Foreground
                 inheritance from NavigationViewItem doesn't reach the icon
                 because Wpf.Ui's LeftCompact item template TemplateBinds
                 the icon's Foreground to its own brush keys. The DataTrigger
                 below watches the ancestor NavigationViewItem.IsActive and
                 sets a local Foreground on the SymbolIcon that wins over
                 the template binding. Scoped to NavigationView.Resources
                 so only the 6 nav icons pick it up (the bottom-bar arrows
                 are siblings of the NavigationView, not children). -->
            <ui:NavigationView.Resources>
                <Style TargetType="ui:SymbolIcon">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}"
                                     Value="True">
                            <!-- accent.text (NOT accent.default) per the mockup CSS:
                                 the brand's "more readable" stop. Darker in light
                                 (violet-700) for contrast against the near-white
                                 selected pill; lighter in dark (violet-300) for
                                 contrast against the dark slate selected pill. -->
                            <Setter Property="Foreground" Value="{DynamicResource accent.text}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:NavigationView.Resources>
            <!-- Initialized handler on each item sets TargetPageType before
                 NavigationView.OnInitialized builds its type->item lookup.
                 See OnNavItemInitialized in MainWindow.xaml.cs. -->
            <!-- SymbolIcon.Filled bound to parent NavigationViewItem.IsActive
                 so selected items get the chunkier filled glyph variant; the
                 unselected items keep the regular line-art variant. Wpf.Ui's
                 SymbolIcon swaps glyph internally on the Filled property. -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavDashboard"
                                       Content="Dashboard"
                                       Initialized="OnNavItemInitialized">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataPie24"
                                       FontSize="20"
                                       Filled="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavPerApp"
                                       Content="Per-App"
                                       Initialized="OnNavItemInitialized">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Apps24"
                                       FontSize="20"
                                       Filled="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavHistory"
                                       Content="History"
                                       Initialized="OnNavItemInitialized">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24"
                                       FontSize="20"
                                       Filled="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavReports"
                                       Content="Reports"
                                       Initialized="OnNavItemInitialized">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentText24"
                                       FontSize="20"
                                       Filled="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!--  Alerts nav-rail item carries a count + pulse-ring badge per
                      the Alerts brief §16.1 and mockup page 9 (Q8-A variant:
                      count + highest-severity tint + one-shot pulse ring).
                      Composition:
                        * Content is a Grid with [Label | Badge container].
                          Label uses ui:TextBlock so it inherits the
                          NavigationViewItem.Foreground brush correctly
                          (a plain TextBlock would be hijacked by the
                          implicit TextBlock style in DesignTokens.xaml).
                        * Badge container stacks two Borders in a Grid:
                          AlertsBadgePulse (back, stroked-only, Opacity=0
                          default with a ScaleTransform render transform —
                          the storyboard target) UNDER AlertsBadgeCount
                          (front, filled tinted pill carrying the count
                          digits).
                        * Count badge Visibility=Collapsed by default
                          (no active alerts → no chrome added to the row).
                          UpdateAlertsBadge in code-behind flips visibility
                          and re-tints the background on every count
                          change; PulseAlertsBadge fires the one-shot
                          ring animation on AlertRaised.
                        * Phase 2 wires the surface + storyboard only —
                          no real count source yet. Phase 6 AlertRaised
                          push hooks UpdateAlertsBadge + PulseAlertsBadge.  -->
                <ui:NavigationViewItem x:Name="NavAlerts"
                                       HorizontalContentAlignment="Stretch"
                                       Initialized="OnNavItemInitialized">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Alert24"
                                       FontSize="20"
                                       Filled="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" />
                    </ui:NavigationViewItem.Icon>
                    <!--  Wpf.Ui v4.0.2's NavigationViewItem template doesn't
                          TemplateBind HorizontalContentAlignment to its
                          inner ContentPresenter, so the Stretch attribute
                          above is a no-op on its own — the ContentPresenter
                          sizes to content and our Star column has no slack
                          to allocate. MinWidth on this Grid forces the
                          claim instead: pane is OpenPaneLength=220, minus
                          icon column + template padding (~64px), so the
                          content slot is ~156. MinWidth=150 is a safe
                          pick that pushes the badge column to the row's
                          right edge regardless of template tweaks.  -->
                    <ui:NavigationViewItem.Content>
                        <Grid MinWidth="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="Alerts"
                                          VerticalAlignment="Center" />
                            <Grid Grid.Column="1"
                                  x:Name="AlertsBadgeContainer"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center">
                                <Border x:Name="AlertsBadgePulse"
                                        Width="18" Height="18"
                                        BorderBrush="{DynamicResource accent.default}"
                                        BorderThickness="2"
                                        CornerRadius="9"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                                <!--  UseLayoutRounding=True snaps the centered
                                      digit to whole pixels so a tabular-numeral
                                      "1" (which sits at the right of its
                                      advance cell in Overpass Mono) lands on
                                      the pixel center, not 0.5px offset.
                                      Typography.NumeralAlignment=Tabular on
                                      the digit pins every numeral to the same
                                      advance grid (WPF equivalent of CSS
                                      font-feature-settings tnum). FontWeight
                                      bold reads cleanly at the 12 px caption
                                      size on saturated severity faces;
                                      semibold was too thin to register.  -->
                                <Border x:Name="AlertsBadgeCount"
                                        Visibility="Collapsed"
                                        MinWidth="18" Height="18"
                                        Background="{DynamicResource status.critical}"
                                        CornerRadius="9"
                                        Padding="6,0"
                                        UseLayoutRounding="True">
                                    <TextBlock x:Name="AlertsBadgeCountText"
                                               Text="0"
                                               FontFamily="{StaticResource font.mono}"
                                               FontSize="{StaticResource font.size.caption}"
                                               FontWeight="{StaticResource font.weight.bold}"
                                               Foreground="{DynamicResource text.on-accent}"
                                               Typography.NumeralAlignment="Tabular"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </ui:NavigationViewItem.Content>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavSettings"
                                       Content="Settings"
                                       Initialized="OnNavItemInitialized">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24"
                                       FontSize="20"
                                       Filled="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource border.subtle}"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: service connection indicator (status dot + text).
                     Fill is set in code (status.connected / .disconnected)
                     so the initial "connecting…" frame doesn't paint with a
                     literal placeholder colour. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ServiceStatusDot"
                             Width="10" Height="10"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="ServiceStatusText"
                               Margin="8,0,0,0"
                               Text="Service: connecting…"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: bottom-bar rate mirror. Visible on every screen
                     so totals are reachable when the user is on Per-App /
                     History / Settings. Arrow Foregrounds and rate Text are
                     refreshed in UpdateBottomBarRates on every snapshot
                     tick (~2 s); when disconnected they all tint to
                     text.tertiary and rates render as "—". -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="BottomBarUpArrow"
                                   Symbol="ArrowUp16"
                                   Foreground="{DynamicResource text.tertiary}"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Name="BottomBarUpRate"
                               Style="{StaticResource text.mono}"
                               Margin="4,0,0,0"
                               Text="—"
                               Foreground="{DynamicResource text.tertiary}"
                               VerticalAlignment="Center" />
                    <ui:SymbolIcon x:Name="BottomBarDownArrow"
                                   Symbol="ArrowDown16"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource text.tertiary}"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Name="BottomBarDownRate"
                               Style="{StaticResource text.mono}"
                               Margin="4,0,0,0"
                               Text="—"
                               Foreground="{DynamicResource text.tertiary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="pack://application:,,,/Assets/favicon.ico"
                        ToolTipText="ZenVizor"
                        TrayLeftMouseDown="OnTrayLeftClick"
                        TrayBalloonTipClicked="OnTrayBalloonTipClicked">
            <tb:TaskbarIcon.ContextMenu>
                <!--  Dynamic label on the first item: "Show ZenVizor" when
                      the window is hidden, "Hide to tray" when it's visible.
                      Header is rewritten in OnTrayContextMenuOpened so it
                      reflects state at popup time.  -->
                <ContextMenu Opened="OnTrayContextMenuOpened">
                    <MenuItem x:Name="TrayShowHideItem"
                              Header="Show ZenVizor"
                              Click="OnTrayShowHideClicked" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnTrayExitClicked" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!--  Phase 6.2: ContentDialog host. Wpf.Ui's ContentDialog requires
              a ContentPresenter as its DialogHost; the dialog renders
              inside that presenter (overlaying the rest of the window via
              z-order). Grid.RowSpan=3 covers TitleBar + content + bottom
              bar so a confirm dialog occludes the chrome too — the brief's
              modal expectation. Pages reach it via
              MainWindow.RootContentDialog (see code-behind).  -->
        <!--  IsHitTestVisible MUST NOT be set False here — WPF inherits
              it to descendants, which would silently neuter every
              ContentDialog shown inside this presenter (Wpf.Ui's
              ContentDialog renders into it as Content, and a
              False-inherited value blocks the dialog's own buttons +
              click surface). When no dialog is showing, Content is null
              so there's no visual to hit-test anyway — the empty
              presenter is harmless on its own.  -->
        <ContentPresenter x:Name="RootContentDialog"
                          Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
