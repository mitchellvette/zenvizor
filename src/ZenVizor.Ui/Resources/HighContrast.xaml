<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ZenVizor — Windows High Contrast token overrides.

        ⚠ STATUS: NOT YET WIRED INTO THE APP. The intended lifecycle (described
        below) is the design contract; the actual subscribe / merge / unmerge
        is tracked as design-system.md §11 item 9 ("HC merge wiring"). App.xaml
        currently merges DesignTokens.xaml + BrandAccent.{Light,Dark}.xaml but
        NOT this dictionary, so an OS HC flip today doesn't change anything
        the app paints. This file is kept current with the brand-token set so
        the eventual wiring is a one-line merge plus the subscribe.

        INTENDED LIFECYCLE (post-wiring): merge only when
        SystemParameters.HighContrast == true. The HC ResourceDictionary
        becomes the LAST entry in Application.Current.Resources.MergedDictionaries
        so its keys win over DesignTokens.xaml + BrandAccent.*. App startup
        subscribes to SystemParameters.StaticPropertyChanged (or
        SystemEvents.UserPreferenceChanged with category=Color) and
        merges/unmerges as HC flips. See the verification gate in
        docs/design-system.md for the toggle recipe (Settings ->
        Accessibility -> Contrast themes -> Aquatic, etc).

        WHY THIS EXISTS: ZenVizor hard-overrides every brush. WPF normally
        yields to SystemColors for the controls it touches — but only when
        you DON'T override. Once you do (which DesignTokens.xaml does), HC
        stops kicking in automatically. Per the design-system HC stance
        (docs/design-system.md "Visual foundations -> High contrast"), we
        ship a parallel dict that re-points every semantic token onto a
        SystemColors brush so HC remains usable.

        HOW THE OVERRIDE WORKS: every brush below uses
            Color="{DynamicResource {x:Static SystemColors.<Name>ColorKey}}"
        rather than aliasing a Wpf.Ui Color. The DynamicResource lookup
        re-fires when the OS HC theme (Aquatic / Desert / Dusk / Night sky)
        changes, so the brush instances we hand out re-paint without the
        app having to do anything.

        WHAT GETS COLLAPSED: HC defines a tiny palette
        (Window/ControlBrush/HighlightBrush/WindowTextBrush/GrayTextBrush)
        and that's it. The granular status colors (success/caution/critical)
        ALL collapse to WindowText/Control because HC has no semantic
        success/error colour — the OS palette is the contract. Charts likewise
        collapse: series colours fall back to WindowText + GrayText for the
        2-series case, which we hand to ChartBuilder by reading these brushes
        at runtime (same wiring as the normal-mode chart paints).

        DOT-LITERAL KEYS PRESERVED. Every x:Key here mirrors the matching key
        in DesignTokens.xaml exactly so the merge is a value-only swap.
    -->

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="surface.background" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="surface.card"       Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="surface.card.alt"   Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="surface.layer"      Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="surface.subtle"     Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="surface.subtle.alt" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <!-- surface.tooltip.scrim collapses to ControlColor — HC has no concept
         of translucent scrim, but the tooltip Border still needs an opaque
         backdrop distinct from Window so the popover reads as raised. -->
    <SolidColorBrush x:Key="surface.tooltip.scrim" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />

    <!--  Text  -->
    <SolidColorBrush x:Key="text.primary"   Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="text.secondary" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="text.tertiary"  Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="text.disabled"  Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="text.inverse"   Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="text.on-accent" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />

    <!--  Accent  -->
    <SolidColorBrush x:Key="accent.default"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="accent.secondary" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="accent.tertiary"  Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="accent.fill"      Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <!-- accent.text collapses to WindowText: HC has no concept of "accent
         foreground text", and eyebrow / small accent labels need to read
         as body text on Control background. -->
    <SolidColorBrush x:Key="accent.text"      Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <!-- accent.subtle collapses to HighlightBrush at low alpha — HC has
         no soft-tint accent; fall back to the OS Highlight colour. -->
    <SolidColorBrush x:Key="accent.subtle"    Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" Opacity="0.20" />

    <!--  Status — collapse to WindowText + Control. HC has no notion of
          success/caution/critical; the OS palette is the contract. The
          *.text variants get WindowText so banners still read; backgrounds
          all collapse to Control so the banner is visible against Window. -->
    <SolidColorBrush x:Key="status.success"             Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="status.success.background"  Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="status.caution"             Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="status.caution.background"  Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="status.caution.text"        Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="status.critical"            Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="status.critical.background" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="status.neutral"             Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="status.neutral.background"  Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />

    <SolidColorBrush x:Key="status.connected"    Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="status.warming"      Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <!-- Mirror status.caution.background collapse: ControlColorKey so the
         warming banner is visible against the Window-colored page. -->
    <SolidColorBrush x:Key="status.warming.background" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="status.disconnected" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <!--  Borders  -->
    <SolidColorBrush x:Key="border.card"   Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <SolidColorBrush x:Key="border.subtle" Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />

    <!--  Polish round 2 additions (June 2026).  metal.card is a gradient
          brushed-card surface; in HC it collapses to a solid Control
          colour since HC has no concept of metallic gradients. edge.light
          is the inset top catch-light on cards; collapses to WindowFrame
          (the same key as borders) so it reads as a thin top stroke if
          visible at all, rather than vanishing entirely. shadow.card is
          a DropShadowEffect; in HC it's replaced with an inert effect
          (Opacity=0) so cards don't render shadows — HC users typically
          want flat high-contrast surfaces, not decorative depth. -->
    <SolidColorBrush x:Key="metal.card"    Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="metal.control" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="edge.light"    Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <DropShadowEffect x:Key="shadow.sm"    Opacity="0" />
    <DropShadowEffect x:Key="shadow.card"  Opacity="0" />

    <!--  Alerts brief additions (June 2026). metal.accent.fill is the
          violet button face gradient; in HC it collapses to HighlightColor
          (the OS accent) so accent buttons remain visibly accent without
          the brand gradient. The .hover / .pressed variants collapse to
          the same Highlight — HC has no separate hover/pressed accent
          colours; the OS-level focus visual is what cues state.

          Known limitation: style.button.accent.fill's Style.Resources
          block inlines the WinUI 3 brush keys (ButtonBackgroundPointerOver
          / Pressed) as gradients. Those inline values DO NOT collapse in
          HC because Style.Resources are scoped inside the Style, not on
          the app resource surface. When HC merge wiring lands
          (design-system.md §11 item 9), the Style will need an HC variant
          override, or the inline brushes will need to be lifted to the
          app resource surface so this HC dict can swap them. For now
          this matches the pattern other Style-internal templates use
          (style.datagrid.compact has the same boundary). -->
    <SolidColorBrush x:Key="metal.accent.fill"         Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="metal.accent.fill.hover"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="metal.accent.fill.pressed" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />

    <!--  Motion tokens are theme-invariant and HC-invariant. Animation
          enable/disable in HC is handled at the code-behind layer via
          SystemParameters.ClientAreaAnimation (the canonical Windows
          gate), so the duration and easing values can stay constant
          across themes. NOT overridden here. -->

    <!--  status.neutral (Info severity) — brand value is the cool blue-
          violet (#4d5fd0 light / #7e8ef7 dark), set in BrandAccent.{Light,
          Dark}.xaml. The existing collapse to WindowText / Control above
          (lines 98-99) handles HC. No change needed. -->


    <!--  Charts — series collapse to WindowText / GrayText / Highlight for
          line/column distinction. The categorical 8-slot palette only has
          three meaningfully-distinct values in HC; that's a known and
          documented limit of HC mode. -->
    <SolidColorBrush x:Key="chart.upSeries"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="chart.downSeries" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="chart.wan"        Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="chart.local"      Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="chart.series.1"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="chart.series.2"   Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="chart.series.3"   Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="chart.series.4"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="chart.series.5"   Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="chart.series.6"   Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="chart.series.7"   Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="chart.series.8"   Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <!--  Chart chrome — axes, gridlines, labels, tooltip, legend. -->
    <SolidColorBrush x:Key="chart.axis"         Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <SolidColorBrush x:Key="chart.gridline"     Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <SolidColorBrush x:Key="chart.axis.label"   Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="chart.tooltip.bg"   Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="chart.tooltip.text" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="chart.legend.text"  Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

</ResourceDictionary>
