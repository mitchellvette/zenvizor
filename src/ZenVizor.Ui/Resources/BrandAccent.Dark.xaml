<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ZenVizor — brand accent overrides, DARK theme.

        See BrandAccent.Light.xaml for the contract. App.xaml.cs swaps the
        brand-accent dictionary's Source URI between Light and Dark on
        every OS Light↔Dark flip.

        Source of truth: docs/design/colors_and_type.css (dark-theme block).
    -->

    <!--  ACCENT  ============================================================
          Lighter ramp in dark theme so accent surfaces (NavigationView
          selection pill, focus rings) stay visible against dark backdrops. -->
    <Color x:Key="SystemAccentColorPrimary">#8254E6</Color>     <!-- violet-500 -->
    <Color x:Key="SystemAccentColorSecondary">#9A72F0</Color>   <!-- violet-400 -->
    <Color x:Key="SystemAccentColorTertiary">#6D3FD1</Color>    <!-- violet-600 -->

    <!--  accent.text — LIGHTER violet (violet-300) so it clears AA against
          dark surface.card. Mirror of the light-theme accent.text role —
          consistently a "more readable" stop away from accent.default. -->
    <SolidColorBrush x:Key="accent.text" Color="#B294F6" />

    <!--  accent.subtle — dark theme uses higher alpha (18%) so the tint
          stays visible against the dark backdrop. CSS source:
          accent-subtle = rgba(130,84,230,0.18). -->
    <SolidColorBrush x:Key="accent.subtle" Color="#2E8254E6" />

    <!--  STATUS  ============================================================
          Brighter foregrounds + slightly higher alpha on dark backgrounds
          (per CSS dark block; 0.16 / 0.18 vs 0.14 / 0.16 / 0.12 light). -->
    <Color x:Key="SystemFillColorSuccess">#2BD1BD</Color>
    <Color x:Key="SystemFillColorCaution">#F1AD34</Color>
    <Color x:Key="SystemFillColorCritical">#F5547F</Color>
    <Color x:Key="SystemFillColorSuccessBackground">#292BD1BD</Color>   <!-- 16% alpha -->
    <Color x:Key="SystemFillColorCautionBackground">#2EF1AD34</Color>   <!-- 18% alpha -->
    <Color x:Key="SystemFillColorCriticalBackground">#2EF5547F</Color>  <!-- 18% alpha -->

    <!--  status.caution.text — body text on the dark caution tint. The
          bright amber (#F1AD34, same hue as status.caution itself)
          clears AA against the dark tint and was the source-of-truth in
          docs/design/colors_and_type.css line 459. Pre-Phase 6.5 this
          key was hardcoded to the LIGHT-theme #8A5A00 in DesignTokens.xaml
          (the P1 amber-banner regression in dark mode); fix is to make
          the key theme-aware via BrandAccent.{Light,Dark}.xaml. -->
    <SolidColorBrush x:Key="status.caution.text" Color="#F1AD34" />

    <!--  status.critical.text — body text on the dark critical tint.
          Light coral pink (#FBA3B7), brighter than status.critical
          (#F5547F) so text and the same-hue alpha-tinted background
          separate cleanly. Clears AA comfortably against the composited
          #2EF5547F-on-#232735 backdrop. Pre-Phase-6.5 the dark theme
          used status.critical for both fg and bg of the critical banner
          surface (same-hue washy). -->
    <SolidColorBrush x:Key="status.critical.text" Color="#FBA3B7" />

    <!--  status.neutral — brand cool blue-violet (lighter ramp for dark
          backdrop legibility, #7e8ef7). NOT Wpf.Ui's SystemFillColorNeutral
          (warm gray). Used by alert Info severity (dot / tile bg / badge).
          CSS source: status-neutral dark. -->
    <Color x:Key="SystemFillColorNeutral">#7E8EF7</Color>
    <Color x:Key="SystemFillColorNeutralBackground">#297E8EF7</Color>   <!-- 16% alpha -->

    <!--  CHART up/down series — lighter brand variants for dark backdrop
          legibility. -->
    <SolidColorBrush x:Key="chart.upSeries" Color="#9A72F0" />      <!-- violet-400 -->
    <SolidColorBrush x:Key="chart.downSeries" Color="#34D0E0" />    <!-- teal-400 -->

    <!--  NAVIGATIONVIEW SELECTION — see Light brand dict for rationale.
          Indicator pill uses accent.default (violet-500) for visible brand
          presence on the dark backdrop; selected label uses accent.text
          (violet-300) for AA contrast. -->
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#8254E6" />        <!-- accent.default (pill) -->
    <!-- Icon foreground on selected items: accent.default (violet-500) to
         match the pill. Was accent.text (violet-300, too light against
         dark backdrop and inconsistent with the pill). -->
    <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent" Color="#8254E6" />            <!-- accent.default (icon) -->
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverLeftFluent" Color="#8254E6" /> <!-- accent.default (icon hover) -->

    <!-- Selected item background — vertical violet fade-out gradient
         per the mockup CSS: linear-gradient(180deg,
         color-mix(accent.default 18%, transparent),
         color-mix(accent.default 7%, transparent)). Same hue at both
         stops (only alpha varies) so the ramp is a clean single-color
         fade — 18% (#2E) top, 7% (#12) bottom. Same gradient on both
         keys. -->
    <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2E8254E6" />
        <GradientStop Offset="1" Color="#128254E6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2E8254E6" />
        <GradientStop Offset="1" Color="#128254E6" />
    </LinearGradientBrush>

    <!--  ACCENT FILL — dark-theme values (lighter ramp). -->
    <Color x:Key="AccentFillColorDefault">#8254E6</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8254E6" />
    <Color x:Key="AccentFillColorSecondary">#9A72F0</Color>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#9A72F0" />
    <Color x:Key="AccentFillColorTertiary">#6D3FD1</Color>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6D3FD1" />

    <!--  SURFACES + TEXT + BORDERS (theme-aware brushes) — see Light brand
          dict for the rationale. Values are brand-aligned per
          docs/design/colors_and_type.css §3 dark block.

          surface.background is intentionally semi-transparent (60% alpha
          brand dark slate) and painted ONCE on the MainWindow outer Grid
          (MainWindow.xaml) so the brand tint reads uniformly across the
          page area AND the surrounding chrome (nav pane, title bar,
          bottom-bar). DWM Mica shows through the 60% alpha layer.
          ApplicationBackgroundBrush is direct-overridden to Transparent
          in App.xaml.cs so Pages render see-through over the MainWindow
          tint (no double-paint, no seam). Cards stay fully opaque on the
          lighter slate so they read as raised surfaces and text
          legibility isn't wallpaper-dependent.

          text.on-accent is WHITE on dark (previously stored as black —
          that's a bug: brand accent.fill in dark is violet-600, which
          needs white text to clear WCAG AA, not black). -->
    <SolidColorBrush x:Key="surface.background"    Color="#99191C26" />
    <SolidColorBrush x:Key="surface.card"          Color="#FF232735" />
    <SolidColorBrush x:Key="surface.card.alt"      Color="#A8222634" />
    <SolidColorBrush x:Key="surface.layer"         Color="#FF262A38" />
    <SolidColorBrush x:Key="surface.subtle"        Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="surface.subtle.alt"    Color="#09FFFFFF" />
    <!--  surface.tooltip.scrim — translucent contrasting scrim for popovers
          (e.g. Per-App ImagePath tooltip). Value = text.primary at 84% alpha
          (alpha 0xD6). Foreground text on this scrim = text.inverse so it
          reads dark-on-light in dark theme. Replaces the opaque-surface
          tooltip treatment so the hovered cell stays visible beneath. -->
    <SolidColorBrush x:Key="surface.tooltip.scrim" Color="#D6F1F2F8" />

    <SolidColorBrush x:Key="text.primary"          Color="#FFF1F2F8" />
    <SolidColorBrush x:Key="text.secondary"        Color="#FFA7ADC0" />
    <SolidColorBrush x:Key="text.tertiary"         Color="#FF717892" />
    <SolidColorBrush x:Key="text.disabled"         Color="#FF515872" />
    <SolidColorBrush x:Key="text.inverse"          Color="#FF181B27" />
    <SolidColorBrush x:Key="text.on-accent"        Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="border.card"           Color="#14FFFFFF" />
    <SolidColorBrush x:Key="border.subtle"         Color="#12FFFFFF" />

    <!--  METALLIC SURFACES  ==================================================
          See Light brand dict for the rationale. In dark theme, edge.light
          (9% alpha white) composites over the slate top stop (#2B3040) to
          ~#3E4351 — baked into metal.card as a third stop at offset 0.015
          so the catch-light is rendered without per-card Rectangle
          layering. The offset scales with card height (~1-3px depending
          on card). edge.light is also exported as a separate token for
          future use on control rims and accent button highlights. -->
    <SolidColorBrush x:Key="edge.light" Color="#17FFFFFF" />
    <LinearGradientBrush x:Key="metal.card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF3E4351" />
        <GradientStop Offset="0.005" Color="#FF2B3040" />
        <GradientStop Offset="1" Color="#FF232735" />
    </LinearGradientBrush>
    <!--  metal.control — see Light brand dict for rationale. Same color
          stops as metal.card dark; ONLY the catch-light offset changes
          from 0.005 to 0.05 so the lit rim is visible on ~30px controls
          (0.05 * 32 = 1.6px, matching what 0.005 * 320 produces on a card). -->
    <LinearGradientBrush x:Key="metal.control" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF3E4351" />
        <GradientStop Offset="0.05" Color="#FF2B3040" />
        <GradientStop Offset="1" Color="#FF232735" />
    </LinearGradientBrush>

    <!--  SHADOWS  ===========================================================
          Card drop shadow approximating the mockup CSS shadow.md dark
          token — deeper black drop with higher opacity, larger blur, and
          longer offset than light. Hardware-composited; idle CPU budget
          unaffected.

          shadow.sm is the softer/smaller sibling — understated elevation
          for the Per-App summary strip and similar info-card surfaces.
          CSS spec dark: 0 1px 2px rgba(0,0,0,0.40). -->
    <DropShadowEffect x:Key="shadow.sm"
                      ShadowDepth="1"
                      BlurRadius="4"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.40" />
    <DropShadowEffect x:Key="shadow.card"
                      ShadowDepth="6"
                      BlurRadius="18"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.25" />

    <!--  CHART CHROME — brand-aligned dark values. Match the updated
          surface + text values above so chart chrome reads consistent. -->
    <SolidColorBrush x:Key="chart.axis"            Color="#12FFFFFF" />
    <SolidColorBrush x:Key="chart.gridline"        Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="chart.axis.label"      Color="#FF717892" />
    <SolidColorBrush x:Key="chart.tooltip.bg"      Color="#FF232735" />
    <SolidColorBrush x:Key="chart.tooltip.text"    Color="#FFF1F2F8" />
    <SolidColorBrush x:Key="chart.legend.text"     Color="#FFA7ADC0" />

</ResourceDictionary>
