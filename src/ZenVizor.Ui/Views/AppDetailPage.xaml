<Page x:Class="ZenVizor.Ui.Views.AppDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- DataGrid row virtualization is engaged programmatically — see
         AppDetailPage.EnforceDataGridBounds in the code-behind. Wpf.Ui's
         NavigationView wraps each hosted page in a DynamicScrollViewer that
         passes infinite vertical extent down, so XAML MaxHeight bindings up
         the visual-tree chain don't propagate a finite measure constraint.
         Setting MaxHeight directly on each DataGrid at Loaded / SizeChanged
         is the only thing that reliably caps it.

         Page-level scrolling: with row 4/5 MinHeights enforced (see row
         defs below), the page content can exceed the viewport at small
         window sizes — and the NavigationView wrapper's scroll behaviour
         is unreliable for that overflow, leaving the grids row inaccessible.
         Own the scrolling here: PageScroll wraps the content; the inner
         Border binds MinHeight to ViewportHeight so the * rows still
         expand to fill at large window sizes (without the binding,
         ScrollViewer would arrange content at its desired height only,
         collapsing rows 4+5 to their MinHeight floors with empty space
         below). Border.Padding="24" replaces the former root-Grid
         Margin="24" so the page keeps its 24px outer inset while
         ViewportHeight (computed inside the Padding) drives the inner
         MinHeight exactly to the visible area. ToastBanner sits OUTSIDE
         the ScrollViewer so it pins to the viewport bottom regardless of
         scroll position. -->
    <Page.Resources>
        <!--  Phase 8 — used by the Connections grid's "Remote endpoint"
              column to hide the hostname line when ResolvedHost is null,
              falling back to the IP-only template. Stock WPF converter,
              keyed BoolToVisibility to match the AlertsPage precedent.  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <Grid>
        <ScrollViewer x:Name="PageScroll"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="24"
                    MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
                <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: breadcrumb back + window picker -->
            <RowDefinition Height="Auto" /> <!-- Row 1: page title + AppId chip -->
            <RowDefinition Height="Auto" /> <!-- Row 2: status banner -->
            <RowDefinition Height="Auto" /> <!-- Row 3: summary card (Phase 2 will rebuild contents) -->
            <!--  Row 4/5 sizing — chart-hero layout.
                  Row 4 (chart) is the only * row; it absorbs ALL residual
                  space after the Auto rows and Row 5's content size. Row 5
                  (grids) is Auto, sizing to its content — which is itself
                  bounded by the DataGrid MaxHeight that
                  EnforceDataGridBounds installs in the code-behind
                  (capped at 360 absolute so the grids row doesn't outpace
                  the chart at large windows).

                  Initial attempt was 3*:2* weighted sharing residual. WPF
                  Grid * arrange gives each row its measured desired first,
                  then splits excess by weight — and the grids row's
                  measured desire scales with the DataGrid MaxHeight
                  formula, so at 4K the grids row started ~700px ahead of
                  the chart row's MinHeight=260 floor and the proportional
                  excess split couldn't bridge the gap. Auto on Row 5 pins
                  it to its (capped) content size, leaving Row 4 the
                  deterministic owner of all residual.

                  MinHeight=260 on Row 4 is still load-bearing: in the
                  PageScroll wrapper above, * rows can collapse below
                  their child's MinHeight under measure pressure (the same
                  bug Dashboard hit — see DashboardPage.xaml:67-68).
                  MinHeight=252 on Row 5 is effectively redundant (Auto +
                  DataGrid cap floor of 200 + chrome ≥ 252) but kept for
                  symmetry / Phase 4 merge.  -->
            <RowDefinition Height="*" MinHeight="260" /> <!-- Row 4: chart card — sole * row, owns all residual -->
            <RowDefinition Height="Auto" MinHeight="252" /> <!-- Row 5: connections + sessions cards — Auto-sized via DataGrid MaxHeight cap (see EnforceDataGridBounds); Phase 4 will merge into tabbed single card -->
        </Grid.RowDefinitions>

        <!--  Row 0 — breadcrumb back affordance (left) + window picker (right).
              Q3 selected variant: caption-weight "< Per-App" link above the
              page title. Transparent button background so it reads as a link
              rather than a chip; ChevronLeft20 glyph replaces the ASCII '<'.  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       x:Name="BackButton"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0,2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Cursor="Hand"
                       Click="OnBackClick">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ChevronLeft20"
                                   FontSize="14"
                                   Foreground="{DynamicResource text.secondary}"
                                   VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource text.caption}"
                               Foreground="{DynamicResource text.secondary}"
                               Text="Per-App"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <!--  Right cluster — date picker (Phase 5e) + clear button + window
                  preset. The date picker is the override: when set, the chart
                  shows that day's 24-hour local window for this app and the
                  WindowCombo is disabled (visually grayed). When the user clicks
                  the clear-button (visible only when a date is set), the date
                  reverts to null and the WindowCombo re-takes effect.

                  The picker also accepts a date from the Reports → AppDetail
                  drill via AppDetailNavParams, so opening this page from a
                  daily-report row arrives pre-filtered to that report's date.  -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid VerticalAlignment="Center">
                    <ui:CalendarDatePicker x:Name="DatePicker"
                                            Width="180" Height="32"
                                            HorizontalContentAlignment="Right"
                                            IsTodayHighlighted="False" />
                    <!--  Two overlays toggled by OnDatePickerDateChanged:
                          DatePickerOverlay is the tertiary-tone placeholder
                          when Date is null; DatePickerLabel is the primary
                          text.primary formatted-date display when Date is set.
                          Wpf.Ui v4.0.2's closed-state button face doesn't
                          render the formatted Date itself (same gotcha
                          documented at ReportsPage.xaml:104), so we paint
                          the visible label ourselves.  -->
                    <TextBlock x:Name="DatePickerOverlay"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource text.tertiary}"
                               Text="Specific day" />
                    <TextBlock x:Name="DatePickerLabel"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource text.primary}"
                               Text="{Binding ElementName=DatePicker,
                                              Path=Date,
                                              StringFormat={}{0:ddd\, MMM d yyyy}}" />
                </Grid>
                <ui:Button x:Name="ClearDateButton"
                           Margin="6,0,0,0"
                           Visibility="Collapsed"
                           Padding="6,4"
                           Background="Transparent"
                           BorderThickness="0"
                           Cursor="Hand"
                           Click="OnClearDateClick"
                           ToolTip="Clear specific day">
                    <ui:SymbolIcon Symbol="Dismiss16"
                                   FontSize="14"
                                   Foreground="{DynamicResource text.secondary}" />
                </ui:Button>
                <ComboBox x:Name="WindowCombo"
                          Margin="12,0,0,0"
                          Width="120"
                          VerticalAlignment="Center"
                          Background="{DynamicResource metal.control}"
                          BorderBrush="{DynamicResource border.card}"
                          SelectionChanged="OnSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Short}"
                                       ToolTip="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!--  Row 1 — page title (image name) + labeled AppId chip with copy.
              Q4 selected variant: "APP ID N" eyebrow + mono value + copy
              button, beside (not inside) the title. Title binds ImageName
              alone — the "(app id N)" suffix is gone (Q4 lock).  -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,12">
            <ui:TextBlock x:Name="HeaderText"
                          Style="{StaticResource text.subtitle}"
                          FontFamily="{StaticResource font.display}"
                          FontSize="24"
                          MaxWidth="640"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center"
                          Text="App detail" />

            <!--  AppId chip — entire chip is the click target (Phase 2.x
                  adjustment). Border default has accent-neutral chrome;
                  IsMouseOver trigger shifts BorderBrush to accent.default so
                  the chip telegraphs its click affordance. Inner Copy20 is
                  a decorative glyph, not a separate button. MouseLeftButtonUp
                  fires OnCopyAppIdClick, which posts the "Copied" toast.
                  Background=Transparent on the trigger Setter (NOT a literal
                  attribute) so the surface stays hit-testable AND the trigger
                  can swap in the hover tint cleanly.  -->
            <Border x:Name="AppIdChip"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    CornerRadius="{StaticResource radius.control}"
                    Padding="10,4"
                    Cursor="Hand"
                    ToolTip="Copy App ID"
                    MouseLeftButtonUp="OnCopyAppIdClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource surface.subtle}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource border.card}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource accent.default}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource text.eyebrow}"
                               Text="APP ID"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="AppIdValue"
                               Style="{StaticResource text.mono}"
                               FontSize="{StaticResource font.size.caption}"
                               Text="—"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                    <ui:SymbolIcon Symbol="Copy20"
                                   FontSize="12"
                                   Foreground="{DynamicResource text.secondary}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Row 2 — status banner (own row). Default Collapsed; Phase 5
              wires the disconnected (critical) vs error (caution) state
              split. Background + foreground colors are swapped per-state
              in code-behind via SetResourceReference.  -->
        <Border Grid.Row="2"
                x:Name="StatusBanner"
                Visibility="Collapsed"
                Margin="0,0,0,12"
                Background="{DynamicResource status.caution.background}"
                Padding="12,8"
                CornerRadius="{StaticResource radius.control}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon x:Name="StatusBannerGlyph"
                               Symbol="Warning20"
                               FontSize="16"
                               Foreground="{DynamicResource status.caution.text}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                <TextBlock x:Name="StatusBannerText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource status.caution.text}" />
            </StackPanel>
        </Border>

        <!--  Row 3 — summary card. Identity block per Q1 selected variant:
              KPI strip on top (Publisher · Signature on the left, Up · Down
              totals on the right) + trust line (4 mutually-exclusive states)
              + border.subtle divider + path copy row. Path NEVER truncates
              (TextWrapping=Wrap, TextTrimming=None) — App Detail is the
              deepest drill state, the path must always be fully visible.  -->
        <Border Grid.Row="3"
                x:Name="SummaryCard"
                Background="{DynamicResource metal.card}"
                BorderBrush="{DynamicResource border.card}"
                BorderThickness="1"
                CornerRadius="{StaticResource radius.card}"
                Effect="{DynamicResource shadow.card}"
                Padding="20,16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- KPI strip -->
                    <RowDefinition Height="Auto" /> <!-- Trust line -->
                    <RowDefinition Height="Auto" /> <!-- Divider -->
                    <RowDefinition Height="Auto" /> <!-- Path copy row -->
                </Grid.RowDefinitions>

                <!--  KPI strip — left cluster (Publisher · Signature) +
                      right cluster (Up · Down) on opposite ends of the
                      same row. Each cell is a caption label above a body
                      value; the right cell's values render in text.mono
                      at font.size.metric (24px SemiBold) in the matching
                      chart series color so the headline numbers read at
                      a glance.  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Style="{StaticResource text.caption}"
                                       Foreground="{DynamicResource text.secondary}"
                                       Text="Publisher" />
                            <TextBlock x:Name="PublisherValue"
                                       Style="{StaticResource text.body}"
                                       Foreground="{DynamicResource text.tertiary}"
                                       Text="—"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource text.caption}"
                                       Foreground="{DynamicResource text.secondary}"
                                       Text="Signature" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ui:SymbolIcon x:Name="SignatureGlyph"
                                               Symbol="ShieldCheckmark20"
                                               FontSize="14"
                                               Foreground="{DynamicResource text.tertiary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                <TextBlock x:Name="SignatureValue"
                                           Style="{StaticResource text.body}"
                                           Foreground="{DynamicResource text.tertiary}"
                                           Text="—"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,32,0" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource text.caption}"
                                       Foreground="{DynamicResource text.secondary}"
                                       HorizontalAlignment="Right"
                                       Text="↑ Up · this window" />
                            <TextBlock x:Name="UpTotalValue"
                                       Style="{StaticResource text.mono}"
                                       FontSize="{StaticResource font.size.metric}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource text.tertiary}"
                                       HorizontalAlignment="Right"
                                       Text="—"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource text.caption}"
                                       Foreground="{DynamicResource text.secondary}"
                                       HorizontalAlignment="Right"
                                       Text="↓ Down · this window" />
                            <TextBlock x:Name="DownTotalValue"
                                       Style="{StaticResource text.mono}"
                                       FontSize="{StaticResource font.size.metric}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource text.tertiary}"
                                       HorizontalAlignment="Right"
                                       Text="—"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  Trust line — four mutually-exclusive Borders, exactly
                      one Visible at a time. Computed in code-behind from
                      (SignatureStatus, IsUserWritablePath, has-WAN-row).
                      AlertCombo is the visually elevated case (amber band
                      via status.caution.*); the three signed/fallback
                      states use surface.subtle for a neutral-not-warning
                      backdrop.  -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Border x:Name="TrustAlertCombo"
                            Visibility="Collapsed"
                            Background="{DynamicResource status.caution.background}"
                            CornerRadius="{StaticResource radius.control}"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="ShieldError20"
                                           FontSize="20"
                                           Foreground="{DynamicResource status.caution.text}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource text.body.strong}"
                                           Foreground="{DynamicResource status.caution.text}"
                                           Text="Unsigned app running from a personal folder, with active connections" />
                                <TextBlock Style="{StaticResource text.caption}"
                                           Foreground="{DynamicResource status.caution.text}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="This binary isn't digitally signed and lives in a folder you can write to. That's the pattern malware often uses to stay hidden. It's currently talking to the internet. Worth confirming you recognise it." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="TrustSignedPersonal"
                            Visibility="Collapsed"
                            Background="{DynamicResource surface.subtle}"
                            CornerRadius="{StaticResource radius.control}"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="ShieldCheckmark20"
                                           FontSize="20"
                                           Foreground="{DynamicResource status.success}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource text.body.strong}"
                                           Text="Signed by a verified publisher" />
                                <TextBlock Style="{StaticResource text.caption}"
                                           Foreground="{DynamicResource text.secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Runs from a personal folder (your %LOCALAPPDATA%), which is normal for apps that update themselves, like Chrome. The valid signature is what matters here." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="TrustSignedSystem"
                            Visibility="Collapsed"
                            Background="{DynamicResource surface.subtle}"
                            CornerRadius="{StaticResource radius.control}"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="ShieldCheckmark20"
                                           FontSize="20"
                                           Foreground="{DynamicResource status.success}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource text.body.strong}"
                                           Text="Signed and running from a system folder" />
                                <TextBlock Style="{StaticResource text.caption}"
                                           Foreground="{DynamicResource text.secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Nothing unusual about where this app lives or how it's signed." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  TrustFallback — copy filled in code-behind for
                          uncategorized cases (Unsigned-without-connections,
                          Unsigned-in-system-folder, Unchecked, etc.). Always
                          a neutral surface.subtle band — the headline body
                          and the explainer caption together carry the signal
                          rather than relying on background elevation.  -->
                    <Border x:Name="TrustFallback"
                            Visibility="Collapsed"
                            Background="{DynamicResource surface.subtle}"
                            CornerRadius="{StaticResource radius.control}"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="TrustFallbackGlyph"
                                           Grid.Column="0"
                                           Symbol="Info20"
                                           FontSize="20"
                                           Foreground="{DynamicResource text.secondary}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TrustFallbackHeadline"
                                           Style="{StaticResource text.body.strong}"
                                           Text="" />
                                <TextBlock x:Name="TrustFallbackBody"
                                           Style="{StaticResource text.caption}"
                                           Foreground="{DynamicResource text.secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  border.subtle hairline divider between trust line and
                      path row.  -->
                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource border.subtle}"
                        Margin="0,16,0,12" />

                <!--  Path copy row — entire row is the click target (Phase 2.x
                      adjustment). Default Background=Transparent on the Style
                      Setter (NOT a literal attribute) so the surface stays
                      hit-testable but invisible; IsMouseOver swaps in
                      surface.subtle so the hover state reads as a clickable
                      band. MouseLeftButtonUp fires OnCopyPathClick, which
                      posts the "Copied" toast.

                      Path renders in text.mono with TextWrapping=Wrap +
                      TextTrimming=None — §8.2 locked outcome, NEVER truncated
                      on this screen. Folder glyph anchors the left end;
                      Copy20 glyph (now a decoration, not a button) anchors
                      the right end; the path takes all the residual width
                      and wraps across multiple lines if needed.  -->
                <Border Grid.Row="3"
                        x:Name="PathRowHost"
                        CornerRadius="{StaticResource radius.control}"
                        Padding="10,8"
                        Margin="-10,-8"
                        Cursor="Hand"
                        ToolTip="Copy path"
                        MouseLeftButtonUp="OnCopyPathClick">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource surface.subtle}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Folder20"
                                       FontSize="16"
                                       Foreground="{DynamicResource text.secondary}"
                                       VerticalAlignment="Top"
                                       Margin="0,3,10,0" />
                        <TextBlock Grid.Column="1"
                                   x:Name="PathValue"
                                   Style="{StaticResource text.mono}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Foreground="{DynamicResource text.tertiary}"
                                   VerticalAlignment="Center"
                                   Text="—" />
                        <ui:SymbolIcon Grid.Column="2"
                                       Symbol="Copy20"
                                       FontSize="14"
                                       Foreground="{DynamicResource text.secondary}"
                                       VerticalAlignment="Top"
                                       Margin="10,3,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  Row 4 — chart card. Canonical card recipe; chart contents
              unchanged in Phase 1 (Phase 3 plumbs grain-aware labelers
              via ChartBuilder).
              MinHeight=260 carries: 16 padding (8+8) + ~30 title + ~24
              subtitle + 180 chart canvas + ~10 axis-label breathing room.
              Phase 3 bumped from 220 (which clipped X-axis labels at small
              window sizes). Paired with RowDefinition.MinHeight=260 on the
              grid above so the row can't shrink below the Border floor.  -->
        <Border Grid.Row="4"
                x:Name="ChartCard"
                Background="{DynamicResource metal.card}"
                BorderBrush="{DynamicResource border.card}"
                BorderThickness="1"
                CornerRadius="{StaticResource radius.card}"
                Effect="{DynamicResource shadow.card}"
                Padding="8"
                MinHeight="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:TextBlock Grid.Row="0" Text="Traffic over time" Margin="4,2,0,2" />
                <TextBlock Grid.Row="1" x:Name="ChartSubtitle"
                           Margin="4,0,0,8"
                           Foreground="{DynamicResource text.secondary}" />
                <Grid Grid.Row="2">
                    <lvc:CartesianChart x:Name="SeriesChart"
                                        Background="Transparent"
                                        MinHeight="180"
                                        LegendPosition="Top" />
                    <TextBlock x:Name="NoDataOverlay"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource text.secondary}"
                               Text="No traffic recorded in this window."
                               IsHitTestVisible="False" />
                    <!--  Loading overlay — centered ProgressRing + caption.
                          Visibility flips via the 1s _loadingDelayTimer in
                          code-behind so fast refreshes don't flash a ring.  -->
                    <StackPanel x:Name="ChartLoadingOverlay"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <ui:ProgressRing IsIndeterminate="True"
                                         HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource text.caption}"
                                   Foreground="{DynamicResource text.secondary}"
                                   Text="Loading…"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Row 5 — single tabbed card (Phase 4.1). Connections and
              Recent sessions share one canonical-recipe card with a tab
              strip on top and the active tab's DataGrid filling the body.
              Active tab is underlined with accent.default via the inline
              TabItem template (default WPF TabControl chrome — raised
              bevel, gradient header, content-area border — is fully
              overridden). Info button placeholder top-right hosts the
              column-comprehension popover in Phase 4.4; today it carries
              only its outline + tooltip.  -->
        <Border Grid.Row="5"
                x:Name="GridsCard"
                Margin="0,12,0,0"
                Background="{DynamicResource metal.card}"
                BorderBrush="{DynamicResource border.card}"
                BorderThickness="1"
                CornerRadius="{StaticResource radius.card}"
                Effect="{DynamicResource shadow.card}">
            <Grid>
                <TabControl x:Name="GridsTab"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="12,8,12,8">
                    <TabControl.Resources>
                        <!--  Inline TabItem template — strips WPF's default
                              chrome (raised bevel, gradient header,
                              content-area border) and renders a clean
                              caption with an active-state underline via
                              BorderBrush on the bottom edge. MinWidth=200
                              + horizontal Padding give each tab room for
                              its glyph + label + count without clipping
                              (the default TabPanel sized tabs to content
                              with no buffer, which truncated the longer
                              "Recent sessions" caption). Hover lifts the
                              tab visually with a surface.subtle background
                              fill — text.primary alone wasn't enough
                              contrast over text.secondary.  -->
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource text.secondary}" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="MinWidth" Value="200" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="HeaderHost"
                                                Background="Transparent"
                                                BorderThickness="0,0,0,2"
                                                BorderBrush="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              Margin="0,6,0,8"
                                                              RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="HeaderHost" Property="BorderBrush"
                                                        Value="{DynamicResource accent.default}" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource text.primary}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderHost" Property="Background"
                                                        Value="{DynamicResource surface.subtle}" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource text.primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe20"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="Connections"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionsCount"
                                           Style="{StaticResource text.caption}"
                                           Foreground="{DynamicResource text.tertiary}"
                                           Text="0"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                        <DataGrid x:Name="ConnectionsGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0"
                                  AlternatingRowBackground="{DynamicResource surface.subtle.alt}"
                                  Margin="0,8,0,0"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Item"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60" />

                                <!--  Remote endpoint — IP address in mono, with
                                      a hover-revealed copy affordance. Cells
                                      can't be selected in this grid (no
                                      selection mode wired), so without this
                                      the user had to type the address out
                                      manually for diagnostics. Border +
                                      MouseLeftButtonUp matches the AppId chip /
                                      path-row pattern from Phase 2.x rather
                                      than a Button (avoids fighting the
                                      default Button chrome inside a cell).  -->
                                <DataGridTemplateColumn Header="Remote endpoint"
                                                        Width="*"
                                                        SortMemberPath="RemoteAddress">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!--  Phase 8 — when the passive DNS observer
                                                      attached a hostname, render it as the
                                                      primary line with the raw address as a
                                                      smaller subscript. When no hostname is
                                                      present, the StackPanel still shows the
                                                      raw address alone (the subscript inherits
                                                      that fallback). RemoteAddress remains the
                                                      sort key and the value copied by the
                                                      hover chip — diagnostics need the IP.  -->
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Vertical"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ResolvedHost}"
                                                               Visibility="{Binding HasHostname, Converter={StaticResource BoolToVisibility}}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ResolvedHost}" />
                                                    <TextBlock Text="{Binding RemoteAddress}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RemoteAddress}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                                                <Style.Triggers>
                                                                    <!--  Subscript treatment ONLY when a hostname
                                                                          sits above it. Without a hostname this
                                                                          line IS the endpoint and stays full-size.  -->
                                                                    <DataTrigger Binding="{Binding HasHostname}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource text.tertiary}" />
                                                                        <Setter Property="FontSize" Value="11" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Tag="{Binding RemoteAddress}"
                                                        Padding="6,2"
                                                        Margin="6,0,0,0"
                                                        CornerRadius="{StaticResource radius.control}"
                                                        Cursor="Hand"
                                                        ToolTip="Copy endpoint"
                                                        MouseLeftButtonUp="OnCopyEndpointClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <!--  Row hover reveals the affordance.  -->
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <!--  Direct hover tints the chip so it
                                                                      reads as clickable rather than
                                                                      decorative.  -->
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource surface.subtle}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ui:SymbolIcon Symbol="Copy20"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource text.secondary}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Port — mono number + plain-language
                                      service caption (443 HTTPS, 5353 mDNS,
                                      8443 HTTPS-alt). Caption is null for
                                      unknown ports and the TextBlock renders
                                      empty so the row stays clean.  -->
                                <DataGridTemplateColumn Header="Port" Width="120"
                                                        SortMemberPath="RemotePort">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RemotePort}"
                                                           Style="{StaticResource text.mono}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PortServiceCaption}"
                                                           Style="{StaticResource text.caption}"
                                                           Foreground="{DynamicResource text.tertiary}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Reach — WAN / Local pill. Background
                                      is chart.wan (blue) for upstream
                                      endpoints, chart.local (green) for
                                      local-network endpoints; icon swaps
                                      Globe20 -> Home20 via the same
                                      DataTrigger on IsWan. text.inverse
                                      reads cleanly on both saturated
                                      backgrounds.  -->
                                <DataGridTemplateColumn Header="Reach" Width="90"
                                                        SortMemberPath="RemoteClass">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{StaticResource radius.control}"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource chart.wan}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWan}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource chart.local}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon FontSize="11"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Globe20" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWan}" Value="False">
                                                                        <Setter Property="Symbol" Value="Home20" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                    <TextBlock Text="{Binding ReachText}"
                                                               Style="{StaticResource text.caption}"
                                                               Foreground="White"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Up / Down — mono right-aligned so the
                                      byte values stack tidily as a column.  -->
                                <DataGridTextColumn Header="Up" Binding="{Binding UpText}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Down" Binding="{Binding DownText}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!--  Connections loading overlay — centered ring +
                              caption. Visibility flips via the 1s timer in
                              code-behind so fast refreshes don't flash.  -->
                        <StackPanel x:Name="ConnectionsLoadingOverlay"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <ui:ProgressRing IsIndeterminate="True"
                                             HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource text.caption}"
                                       Foreground="{DynamicResource text.secondary}"
                                       Text="Loading…"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <!--  Connections empty state — shown by
                              UpdateEmptyStates when Connections.Count==0
                              and we're not loading / in error.  -->
                        <TextBlock x:Name="ConnectionsEmptyOverlay"
                                   Visibility="Collapsed"
                                   Style="{StaticResource text.body}"
                                   Foreground="{DynamicResource text.secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="No endpoints recorded in this window."
                                   IsHitTestVisible="False" />
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History20"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="Recent sessions"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SessionsCount"
                                           Style="{StaticResource text.caption}"
                                           Foreground="{DynamicResource text.tertiary}"
                                           Text="0"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                        <DataGrid x:Name="SessionsGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0"
                                  AlternatingRowBackground="{DynamicResource surface.subtle.alt}"
                                  Margin="0,8,0,0"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Item"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Started" Binding="{Binding StartText}" Width="150"
                                                    SortMemberPath="StartTimeUnixMs">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Ended — formatted timestamp for
                                      completed sessions; for running
                                      sessions, a status.success bullet +
                                      "running" caption swaps in. Both views
                                      are stacked in a Grid; the inactive
                                      one is Collapsed via a DataTrigger on
                                      IsRunning. SortMemberPath rides on
                                      the raw nullable end-time so running
                                      sessions (null end) group together at
                                      one end of the sort.  -->
                                <DataGridTemplateColumn Header="Ended" Width="150"
                                                        SortMemberPath="EndTimeUnixMs">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{DynamicResource status.success}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="running"
                                                               Style="{StaticResource text.body}"
                                                               Foreground="{DynamicResource status.success}"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding EndedText}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Length — derived "Hh Mm" / "Dd Hh"
                                      duration. SortMemberPath=LengthMs so
                                      sort runs on the underlying numeric
                                      value, not the formatted string
                                      (which would put "10h 5m" before
                                      "3h 40m" lexically).  -->
                                <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="80"
                                                    SortMemberPath="LengthMs">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource text.mono}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Services — HostedServices split into
                                      chip-style tags via ItemsControl +
                                      WrapPanel. Borderless cell for the
                                      non-svchost rows (ServiceTags empty
                                      list). SortMemberPath sorts by the
                                      raw comma-separated string so the
                                      service order on the wire is the
                                      sort key.  -->
                                <DataGridTemplateColumn Header="Services" Width="*"
                                                        SortMemberPath="HostedServices">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ServiceTags}"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource border.subtle}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource radius.control}"
                                                                Padding="8,2"
                                                                Margin="0,2,4,2">
                                                            <TextBlock Text="{Binding}"
                                                                       Style="{StaticResource text.caption}"
                                                                       Foreground="{DynamicResource text.secondary}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!--  Sessions loading overlay — same pattern as
                              Connections; both rings show together so a
                              tab switch during loading still reveals a
                              ring rather than an empty grid.  -->
                        <StackPanel x:Name="SessionsLoadingOverlay"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <ui:ProgressRing IsIndeterminate="True"
                                             HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource text.caption}"
                                       Foreground="{DynamicResource text.secondary}"
                                       Text="Loading…"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <!--  Sessions empty state — shown by
                              UpdateEmptyStates when Sessions.Count==0 and
                              we're not loading / in error.  -->
                        <TextBlock x:Name="SessionsEmptyOverlay"
                                   Visibility="Collapsed"
                                   Style="{StaticResource text.body}"
                                   Foreground="{DynamicResource text.secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="No sessions recorded in this window."
                                   IsHitTestVisible="False" />
                        </Grid>
                    </TabItem>
                </TabControl>

                <!--  Info button — opens the InfoPopup below with plain-
                      language column legends. Popup content swaps Connections
                      <-> Sessions automatically via DataTriggers on
                      GridsTab.SelectedIndex, so a tab switch while the
                      popup is open re-keys the content without needing a
                      code-behind hook.  -->
                <ui:Button x:Name="InfoButton"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,12,16,0"
                           Width="28" Height="28"
                           Padding="0"
                           Background="Transparent"
                           BorderBrush="{DynamicResource border.card}"
                           BorderThickness="1"
                           CornerRadius="{StaticResource radius.control}"
                           Cursor="Hand"
                           ToolTip="Column info"
                           PreviewMouseDown="OnInfoButtonPreviewMouseDown"
                           Click="OnInfoClick">
                    <ui:SymbolIcon Symbol="Info20"
                                   FontSize="14"
                                   Foreground="{DynamicResource text.secondary}" />
                </ui:Button>

                <!--  Column-legend popover. PlacementTarget=InfoButton +
                      Placement=Top + HorizontalOffset=-292 anchors the
                      popup's right edge to the button's right edge
                      (button w=28, popup w=320, so offset = 28 - 320)
                      and its bottom edge 4px above the button. Placement=
                      Top means the popup grows up over the CHART card
                      above instead of down into the grids — keeps the
                      data visible and avoids window-overflow on smaller
                      window sizes. StaysOpen=False auto-dismisses on
                      outside click. AllowsTransparency=True so the card's
                      rounded corners + shadow render through the popup
                      host window. Content is two StackPanels stacked in
                      a Grid; only the one matching GridsTab.SelectedIndex
                      is Visible.  -->
                <Popup x:Name="InfoPopup"
                       PlacementTarget="{Binding ElementName=InfoButton}"
                       Placement="Top"
                       HorizontalOffset="-292"
                       VerticalOffset="-4"
                       AllowsTransparency="True"
                       StaysOpen="False">
                    <Border Background="{DynamicResource surface.card}"
                            BorderBrush="{DynamicResource border.card}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource radius.card}"
                            Effect="{DynamicResource shadow.card}"
                            Padding="20"
                            Width="320">
                        <Grid>
                            <StackPanel x:Name="ConnectionsInfoContent">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=GridsTab}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource text.body.strong}"
                                           Text="Connections columns"
                                           Margin="0,0,0,12" />
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="PROTO" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="TCP or UDP. The transport protocol the connection uses." />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="REMOTE ENDPOINT" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="The server this app talked to. When ZenVizor can work out the site's name it shows that above the IP address; some connections stay IP-only because the name was hidden inside encrypted traffic and can't be read." />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="PORT" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="The destination port, with a hint at the service it usually means (HTTPS for 443, mDNS for 5353, etc.)." />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="REACH" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="Where the endpoint sits. WAN means out on the public internet; Local means somewhere on your home network." />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="UP / DOWN" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="Bytes this app sent and received over the selected window." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SessionsInfoContent">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=GridsTab}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource text.body.strong}"
                                           Text="Sessions columns"
                                           Margin="0,0,0,12" />
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="SESSION" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="ZenVizor's record ID for this run of the app." />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="PID" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="The Windows process ID assigned to this run." />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="STARTED · ENDED" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="When the app started and stopped. 'running' means the app is still active right now." />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="LENGTH" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="How long this run lasted (or has been running so far)." />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource text.eyebrow}" Text="SERVICES" />
                                    <TextBlock Style="{StaticResource text.body}"
                                               Foreground="{DynamicResource text.secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="For svchost.exe: which Windows services were hosted in this process during its lifetime." />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>

    </Grid>
            </Border>
        </ScrollViewer>

        <!--  Copied-to-clipboard toast (Phase 2.x). Sibling of PageScroll
              so it pins to the VIEWPORT bottom regardless of scroll
              position — inside the ScrollViewer, VerticalAlignment="Bottom"
              would track the scrolling content's bottom instead, leaving
              the toast off-screen on a scrolled page. IsHitTestVisible=
              False so it never steals mouse events from the controls
              beneath. Scrim styling matches Per-App's tooltip
              (surface.tooltip.scrim background + text.inverse text —
              readable on both light + dark themes). ShowCopiedToast() in
              code-behind flips Visibility and resets a 1.5s
              DispatcherTimer that flips it back.  -->
        <Border x:Name="ToastBanner"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,32"
                Background="{DynamicResource surface.tooltip.scrim}"
                CornerRadius="{StaticResource radius.control}"
                Effect="{DynamicResource shadow.card}"
                Padding="14,10"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Checkmark20"
                               FontSize="16"
                               Foreground="{DynamicResource text.inverse}"
                               VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText"
                           Text="Copied to clipboard"
                           Foreground="{DynamicResource text.inverse}"
                           Style="{StaticResource text.body}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
