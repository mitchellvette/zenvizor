<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <!-- NU1701: LiveChartsCore.SkiaSharpView.WPF 2.0.4 transitively depends on
         SkiaSharp.Views.WPF and OpenTK packages that still target legacy net48.
         They are runtime-compatible with net10.0-windows; the warning is noise.
         VSTHRD100/101: async-void event handlers and async lambdas attached to
         WPF events are idiomatic in code-behind; exceptions inside RefreshAsync
         are caught and surfaced via the StatusBanner, not allowed to propagate. -->
    <NoWarn>$(NoWarn);NU1701;VSTHRD100;VSTHRD101</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Phase 5c — Reports serializer helpers (Escape, FormatBytes, etc.)
       are internal because they aren't surface API. Integration.Tests
       exercises them directly via this grant. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ZenVizor.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenVizor.Core\ZenVizor.Core.csproj" />
    <ProjectReference Include="..\ZenVizor.Ipc.Client\ZenVizor.Ipc.Client.csproj" />
    <ProjectReference Include="..\ZenVizor.Ipc.Contracts\ZenVizor.Ipc.Contracts.csproj" />
  </ItemGroup>

  <!-- Design system fonts. Linked under Fonts/ in the assembly so the pack URI
       resolves as pack://application:,,,/Fonts/#<FamilyName>. Internal family
       names (probed via System.Windows.Media.Fonts.GetFontFamilies): Urbanist,
       Overpass Mono, Nuqun.

       All four Urbanist faces ship so FontWeight resolves to a real on-disk
       glyph (300/400/600/700) — never a synthesized weight. SemiBold (600) is
       the brand's title/subtitle weight; without the SemiBold .ttf, WPF would
       fake the weight from Regular, which produces blurry strokes and
       inconsistent metrics. -->
  <!-- Brand assets. The .ico is referenced by <ApplicationIcon> above (Windows
       uses it for the .exe icon shown in Explorer, taskbar, alt-tab) AND
       included as a Resource so FluentWindow.Icon / TaskbarIcon.IconSource
       can load it via pack URI at runtime. The SVG ships as None (build-time
       documentation only, not embedded) — it's the Illustrator source of
       truth; the title-bar wordmark is reconstructed inline in MainWindow.xaml
       using the same Nuqun font and per-letter positioning the SVG defines. -->
  <ItemGroup Label="Brand assets">
    <Resource Include="Assets\favicon.ico" />
    <None Include="Assets\zv_wordmark_v1.svg" />
  </ItemGroup>

  <ItemGroup Label="Design system fonts">
    <Resource Include="..\..\fonts\Urbanist-Light.ttf"    Link="Fonts\Urbanist-Light.ttf" />
    <Resource Include="..\..\fonts\Urbanist-Regular.ttf"  Link="Fonts\Urbanist-Regular.ttf" />
    <Resource Include="..\..\fonts\Urbanist-SemiBold.ttf" Link="Fonts\Urbanist-SemiBold.ttf" />
    <Resource Include="..\..\fonts\Urbanist-Bold.ttf"     Link="Fonts\Urbanist-Bold.ttf" />
    <Resource Include="..\..\fonts\OverpassMono-VariableFont_wght.ttf" Link="Fonts\OverpassMono-VariableFont_wght.ttf" />
    <Resource Include="..\..\fonts\Nuqun-Regular.otf"     Link="Fonts\Nuqun-Regular.otf" />
  </ItemGroup>

</Project>
