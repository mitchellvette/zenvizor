<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NU1701: LiveChartsCore.SkiaSharpView.WPF 2.0.4 transitively depends on
         SkiaSharp.Views.WPF and OpenTK packages that still target legacy net48.
         They are runtime-compatible with net10.0-windows; the warning is noise.
         VSTHRD100/101: async-void event handlers and async lambdas attached to
         WPF events are idiomatic in code-behind; exceptions inside RefreshAsync
         are caught and surfaced via the StatusBanner, not allowed to propagate. -->
    <NoWarn>$(NoWarn);NU1701;VSTHRD100;VSTHRD101</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenVizor.Core\ZenVizor.Core.csproj" />
    <ProjectReference Include="..\ZenVizor.Ipc.Client\ZenVizor.Ipc.Client.csproj" />
    <ProjectReference Include="..\ZenVizor.Ipc.Contracts\ZenVizor.Ipc.Contracts.csproj" />
  </ItemGroup>

  <!-- Design system fonts. Linked under Fonts/ in the assembly so the pack URI
       resolves as pack://application:,,,/Fonts/#<FamilyName>. Internal family
       names (probed via System.Windows.Media.Fonts.GetFontFamilies): Urbanist,
       NF Code, Nuqun. -->
  <ItemGroup Label="Design system fonts">
    <Resource Include="..\..\fonts\Urbanist-Light.ttf"   Link="Fonts\Urbanist-Light.ttf" />
    <Resource Include="..\..\fonts\Urbanist-Regular.ttf" Link="Fonts\Urbanist-Regular.ttf" />
    <Resource Include="..\..\fonts\Urbanist-Bold.ttf"    Link="Fonts\Urbanist-Bold.ttf" />
    <Resource Include="..\..\fonts\NFCode-Regular.otf"   Link="Fonts\NFCode-Regular.otf" />
    <Resource Include="..\..\fonts\Nuqun-Regular.otf"    Link="Fonts\Nuqun-Regular.otf" />
  </ItemGroup>

</Project>
